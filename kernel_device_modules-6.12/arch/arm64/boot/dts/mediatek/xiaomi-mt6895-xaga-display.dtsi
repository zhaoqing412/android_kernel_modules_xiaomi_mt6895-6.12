&mtk_leds {
	compatible = "mediatek,disp-leds";

	backlight {
		label = "lcd-backlight";
		led_mode = <4>;
		max-brightness = <4095>;
		max-hw-brightness = <4095>;
		default-state = "half";
	};
};

&i2c6 {
	gate_ic: gate_ic@11 {
		compatible = "mediatek,MI_I2C_LCD_BIAS";
		label = "lcd-backlight";
		pwm_config = <0 1 0 0 0>;
		reg = <0x11>;
		id = <6>;
		status = "okay";
	};
};

&mt6368_vrf18_aif {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&pio {
	mtkfb_pins_lcm_rst_out1_gpio: lcm_rst_out1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO41__FUNC_GPIO41>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_rst_out0_gpio: lcm_rst_out0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO41__FUNC_GPIO41>;
			slew-rate = <1>;
			output-low;
		};
	};
	mtkfb_pins_lcm_dsi_te: lcm_dsi_te {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO40__FUNC_DSI_TE>;
		};
	};

	mtkfb_pins_lcm_dvdd_en1: lcm_dvdd_en1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_dvdd_en0: lcm_dvdd_en0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			slew-rate = <1>;
			output-low;
		};
	};

	mtkfb_pins_lcm_cam_en1: lcm_cam_en1_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO158__FUNC_GPIO158>;
			slew-rate = <1>;
			output-high;
		};
	};

	mtkfb_pins_lcm_cam_en0: lcm_cam_en0_gpio {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO158__FUNC_GPIO158>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&mtkfb {
	/* xaga: pinctrl-* removed - same fw_devlink pio-child supplier blocking
	 * as dispsys_config (see comment there); mtkfb itself doesn't probe a
	 * pinctrl-driven device in 6.12.
	 */
	status = "okay";
};
&dispsys_config {
	/* xaga: all pinctrl-* removed - the DRM master driver (mtk_drm_drv.c)
	 * never uses pinctrl; backlight/power GPIOs are owned by leds-mtk-disp and
	 * the panel driver. On 6.12 fw_devlink treats every pinctrl-N phandle as a
	 * supplier that must probe as a device; these &pio child nodes never do,
	 * so dispsys_config was blocked forever (links_ret=-517) -> no DRM master
	 * -> recovery graphics timeout (real-device 2026-08-12).
	 */
	status = "okay";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	panel1@0 {
		/* xaga: panel1@0 = l16_36 (real panel). Stock xagaforge 5.10 has
		 * panel1@0=l16_42 and relies on LK rewriting dsi_out to the detected
		 * panel (l16_36); on 6.12 LK's "set dsi panel index to dtb" fails, so
		 * dsi_out stays on panel_in1 - make panel_in1 the real panel so the
		 * kernel probes l16_36 without depending on the LK rewrite (real
		 * device 2026-08-13, display size 0x0 + atomic oops).
		 */
		compatible = "l16_36_02_0b_dsc_vdo,lcm";
		reg = <0>;
		reset-gpios = <&pio 41 0>;
		dvdd-gpios = <&pio 118 0>;
		cam-gpios = <&pio 158 0>;
		leden-gpios = <&pio 215 0>;
		vrf18-supply = <&mt6368_vrf18_aif>;
		pinctrl-names = "default";
		port {
			panel_in1: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	panel2@0 {
		compatible = "l16_42_02_0a_dsc_vdo,lcm";
		reg = <1>;
		reset-gpios = <&pio 41 0>;
		dvdd-gpios = <&pio 118 0>;
		cam-gpios = <&pio 158 0>;
		leden-gpios = <&pio 215 0>;
		vrf18-supply = <&mt6368_vrf18_aif>;
		pinctrl-names = "default";
		port {
			panel_in2: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
	ports {
		port {
			/* xaga: dsi_out -> panel_in1 (l16_42) matches the stock
			 * xagaforge 5.10 board file. LK's disp_lcm_fill_lcm_dts_phandle
			 * rewrites dsi_out to the detected panel (l16_36 = panel2); a
			 * pre-set panel_in2 target made LK's "set dsi panel index to
			 * dtb" fail on device -> panel never probed -> crtc had no
			 * timing (display size 0x0) -> atomic oops in
			 * mtk_dsi_connector_duplicate_state (real device 2026-08-13).
			 */
			dsi_out: endpoint {
				remote-endpoint = <&panel_in1>;
			};
		};
	};
};

&disp_aal0 {
	mtk_dre30_support = <1>;
};

&disp_aal1 {
	mtk_dre30_support = <1>;
};
