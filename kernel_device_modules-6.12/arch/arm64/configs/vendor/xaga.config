# xaga (Xiaomi Redmi Note 11T Pro / POCO X4 GT / Redmi K50i, MT6895) defconfig fragment
# Ported from the 5.10 ESK kernel (arch/arm64/configs/vendor/xaga.config) to the
# 6.12 MTK modules tree. Merge with the GKI + mgk_64_k612_defconfig base via
# scripts/kconfig/merge_config.sh (or the mgk GKI_DEFCONFIG_FRAGMENT hook).
# CONFIG symbol names are the 6.12 tree's own (drivers/input/touchscreen,
# drivers/power/supply/mediatek, drivers/gpu/drm/panel, sound/soc/codecs).

# Camera
CONFIG_CUSTOM_KERNEL_IMGSENSOR="xagas5khm2_mipi_raw xagas5k4h7_mipi_raw xagaov16a1_mipi_raw xagas5kgw1_mipi_raw xagagc02m1_mipi_raw xagaov02b10_mipi_raw"

# Charger / fuel gauge
CONFIG_XMEXT_LN8000_CHG_PUMP=m
CONFIG_XMEXT_SC8551A_CHG_PUMP=m
CONFIG_XMEXT_CHG_PUMP=m
CONFIG_XMEXT_TI_GAUGE=m
CONFIG_XM_PD_MANAGER=m

# Display
CONFIG_DRM_PANEL_L16_42_02_0A_DSC_VDO=m
CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO=m
CONFIG_DRM_PANEL_LEDS_KTZ8863A=m
CONFIG_MI_DISP=y
CONFIG_MI_DISP_ESD_CHECK=y

# Fingerprint (fpc, handled by dtbo; no in-tree driver)

# Haptics (Awinic AW8697, ported from 5.10 ESK aw8697_haptic)
CONFIG_INPUT_AW8697_HAPTIC=m

# Camera flash (KTD2687 dual flash, ported from 5.10 ESK)
CONFIG_MTK_VIDEO_KTD2687=m

# Product
CONFIG_BUILD_PRODUCT_NAME="xaga"
CONFIG_TARGET_PRODUCT_XAGA=y

# Sound
CONFIG_SND_SOC_TFA9874=m
CONFIG_MTK_VOW_BARGE_IN_SUPPORT=y
CONFIG_MTK_VOW_DUAL_MIC_SUPPORT=y
CONFIG_MTK_VOW_MAX_PDK_NUMBER=2

# Touchscreen (novatek NVT36672C SPI + Xiaomi touch class driver + double-click)
CONFIG_TOUCHSCREEN_MTK_TOUCH=""
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
CONFIG_TOUCHSCREEN_XIAOMI_DOUBLE_CLICK=m
CONFIG_TOUCHSCREEN_NVT36672C_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_NVT36672C_DOUBLE_CLICK=m

# Misc
CONFIG_MI_HARDWARE_ID=m
CONFIG_SIMTRAY_STATUS=m

# Boot-stage marker writer (XAGR ring at log_store 0x7ffbf000). BUILT-IN (=y):
# armed at the head of arm64 setup_arch (earliest point the MMU maps the
# region) and mirrors every printk() into the ring, which survives the
# watchdog reboot in DRAM and is dumped by the xaga-marker reader in the
# lineage_xaga kernel on the next boot. Source lives in the OPPO kernel tree
# (drivers/misc/xaga-marker-writer.c); do not build it as a module.
CONFIG_XAGA_MARKER_WRITER=y

# devtmpfs: kernel auto-creates /dev/block nodes without userspace.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Hardware virtualization is unsupported on xaga (MT6895 boot chain is 5.10
# era LK/ATF without a pKVM-capable EL2/hyp): protected-KVM init hangs early.
# The gki base turns KVM=y and bakes "kvm-arm.mode=protected" into
# CONFIG_CMDLINE; merge_config -m is only-add so build.sh overrides both with
# sed (see build.sh config()). These lines document intent (and apply in the
# kleaf/mgk fragment path, which overrides):
# CONFIG_KVM is not set
# CONFIG_MTK_PKVM_MKP is not set
# CONFIG_MTK_PKVM_MTK_SMC_HANDLER is not set
# CONFIG_MTK_PKVM_TMEM is not set
# CONFIG_MTK_PKVM_SMMU is not set
# CONFIG_MTK_PKVM_ISP is not set
# CONFIG_MTK_PKVM_CMDQ is not set

# MT6895 (Cortex-A78/A55, ARMv8.2) lacks the ARMv8.4+/8.5+ features the OPPO
# gki enables; AMU also needs the 5.10-era ATF to have enabled counter access
# (it never did - 5.10 has no AMU support at all, so this is untested ground
# and the kernel reads AMU counters at boot). Disable all of them via build.sh
# sed (same only-add merge reason):
# CONFIG_ARM64_AMU_EXTN is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_EPAN is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_E0PD is not set
# Kept (proven booting on xaga by the 5.10 GKI kernels): PTR_AUTH_KERNEL,
# CFI_CLANG, SHADOW_CALL_STACK, RANDOMIZE_BASE, CNP, SVE.

# The OPPO gki ships KASAN=y + KASAN_HW_TAGS=y (MTE-backed). The device lacks
# MTE, so HW_TAGS silently no-ops while disabling MTE (above) would flip KASAN
# to GENERIC and bloat Image 36MB -> 67MB. KASAN is a debug feature the
# production xaga kernel does not need (5.10 GKI production builds ship
# without it) - disable it entirely via build.sh sed:
# CONFIG_KASAN is not set
# CONFIG_KASAN_HW_TAGS is not set

# USB serial gadget (g_serial) as kernel log console - ttyGS0 over the
# mtu3 UDC. U_SERIAL_CONSOLE lets ttyGS0 serve as a printk console; add
# console=ttyGS0,115200 to chosen/bootargs (mt6895.dts) to mirror dmesg to
# a USB host's /dev/ttyACM0 (e.g. `screen /dev/ttyACM0 115200`). Requires
# CONFIG_USB_GADGET=y (gki) + mtu3.ko UDC (OOT, already packaged).
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_XAGA_KMSG2USB=y
