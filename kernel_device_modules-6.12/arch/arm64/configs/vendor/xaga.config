# xaga (Xiaomi Redmi Note 11T Pro / POCO X5 Pro, MT6895) defconfig fragment
# Ported from the 5.10 ESK kernel (arch/arm64/configs/vendor/xaga.config) to the
# 6.12 MTK modules tree. Merge with the GKI + mgk_64_k612_defconfig base via
# scripts/kconfig/merge_config.sh (or the mgk GKI_DEFCONFIG_FRAGMENT hook).
# CONFIG symbol names are the 6.12 tree's own (drivers/input/touchscreen,
# drivers/power/supply/mediatek, drivers/gpu/drm/panel, sound/soc/codecs).

# Camera
CONFIG_CUSTOM_KERNEL_IMGSENSOR="xagas5khm2_mipi_raw xagas5k4h7_mipi_raw xagaov16a1_mipi_raw xagas5kgw1_mipi_raw xagagc02m1_mipi_raw xagaov02b10_mipi_raw"

# Charger / fuel gauge
CONFIG_XMEXT_LN8000_CHG_PUMP=m
CONFIG_XMEXT_SC8551A_CHG_PUMP=m
CONFIG_XMEXT_CHG_PUMP=m
CONFIG_XMEXT_TI_GAUGE=m
CONFIG_XM_PD_MANAGER=m
CONFIG_REGULATOR_WL2868C=m

# Display
CONFIG_DRM_PANEL_L16_42_02_0A_DSC_VDO=m
CONFIG_DRM_PANEL_L16_36_02_0B_DSC_VDO=m
CONFIG_DRM_PANEL_LEDS_KTZ8863A=m
CONFIG_MI_DISP_ESD_CHECK=y

# Fingerprint
CONFIG_GOODIX_CAP_FINGERPRINT=m

# Haptics (Awinic AW8697, ported from 5.10 ESK aw8697_haptic)
CONFIG_INPUT_AW8697_HAPTIC=m

# Product
CONFIG_BUILD_PRODUCT_NAME="xaga"
CONFIG_TARGET_PRODUCT_XAGA=y

# Sound
CONFIG_SND_SOC_TFA9874=m
CONFIG_MTK_VOW_BARGE_IN_SUPPORT=y
CONFIG_MTK_VOW_DUAL_MIC_SUPPORT=y
CONFIG_MTK_VOW_MAX_PDK_NUMBER=2

# Touchscreen (novatek NVT36672C SPI + Xiaomi touch class driver + double-click)
CONFIG_TOUCHSCREEN_MTK_TOUCH=""
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
CONFIG_TOUCHSCREEN_XIAOMI_DOUBLE_CLICK=m
CONFIG_TOUCHSCREEN_NVT36672C_HOSTDL_SPI=m
CONFIG_TOUCHSCREEN_NVT36672C_DOUBLE_CLICK=m

# Misc
CONFIG_MI_HARDWARE_ID=m
CONFIG_SIMTRAY_STATUS=m

# Kernel log -> "oops" partition (/dev/block/sdc81) via pstore/blk.
# pstore/blk captures panic/oops dmesg (KMSG_DUMP_PANIC..OOPS by default,
# PSTORE_BLK_MAX_REASON=2) plus console/pmsg records into the block-device
# zone; read back with: mount -t pstore pstore /sys/fs/pstore
CONFIG_PSTORE_BLK=y
CONFIG_PSTORE_BLK_BLKDEV="/dev/block/sdc81"
