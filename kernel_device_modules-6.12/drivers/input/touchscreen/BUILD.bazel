load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)

package(
    default_visibility = ["//visibility:public"],
)

define_mgk_ddk_ko(
    name = "double_click",
    srcs = ["double_click.c"],
    hdrs = glob(["*.h"]),
    includes = ["."],
)

define_mgk_ddk_ko(
    name = "xiaomi_touch",
    srcs = ["xiaomi/xiaomi_touch.c"],
    hdrs = glob(["xiaomi/*.h"]),
    includes = ["."],
    copts = [
        "-I$(DEVICE_MODULES_PATH)/drivers/input/touchscreen/xiaomi",
    ],
)
